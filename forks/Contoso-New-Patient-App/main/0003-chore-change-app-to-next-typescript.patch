-        <div>
-          <Button onClick={buttonClick}>
-            <>
-              <Icon path={mdiCameraIris} size={1} />
-              <br />
-              Take a picture
-            </>
-          </Button>
-
-          <canvas ref={canvasRef} className={hidden} />
-        </div>
-      )}
-    </>
-  );
-}
