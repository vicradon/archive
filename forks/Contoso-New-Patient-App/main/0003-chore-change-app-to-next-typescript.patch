-      if (context) {
-        context.drawImage(video, 0, 0, video.videoWidth, video.videoHeight);
-
-        canvas.toBlob((blob) => {
-          if (blob) {
-            const file = new File([blob], "image.png", {
-              type: "image/png",
-            });
-            captureImage(file);
-          }
-        });
-      }
-    }
-  }, [captureImage, videoRef, canvasRef]);
