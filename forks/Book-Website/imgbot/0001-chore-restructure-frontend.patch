+  --background-color: #232323;
+  background-color: var(--background-color);
+  padding: 20px;
+  padding-left: 40px;
+  padding-right: 40px;
+  border: 1px solid var(--background-color);
+  color: white;
+}
+
+@media (max-width: 1200px) {
+  .display-1 {
+    font-size: 50px;
+  }
+}
+
+@media (max-width: 996px) {
+  .display-1 {
+    font-size: 40px;
+  }
+}
+
+@media (max-width: 768px) {
+  .display-1 {
+    font-size: 35px;
+  }
+  .book {
+    width: 100%;
+    height: auto;
+  }
+}
+
+@media (max-width: 576px) {
+  .display-1 {
+    font-size: 30px;
+  }
+}
+
+.mb-4 {
+  margin-bottom: 2rem;
+}
