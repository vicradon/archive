diff --git a/css/style.css b/css/style.css
index 78be597..96a1f78 100644
--- a/css/style.css
+++ b/css/style.css
@@ -1,163 +1,171 @@
-body {
-    box-sizing: border-box;
-    overflow-x: hidden;
+*,
+::before,
+::after {
+  margin: 0;
+  padding: 0;
+  box-sizing: border-box;
 }
 
 header {
-    background-color: #f8f8f8;
-    height: 50vh;
-    width: 100vw;
-    padding: 100px;
-    padding-left: 250px;
-    padding-bottom: 200px;
-    padding-right: 200px;
+  background-color: #f8f8f8;
+  min-height: 100vh;
 }
 
 .image-header {
-    display: flex;
-    justify-content: center;
-    align-items: center;
-    margin-top: -350px;
+  padding: 2rem 0;
 }
 
 .header-main {
-    display: flexbox;
-    margin-top: 50px;
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: space-between;
+  width: 80vw;
+  margin: 0 auto;
 }
 
 .header-text {
-    font-family: "Playfair Display", serif;
-    line-height: 32px;
-    font-family: "Questrial", sans-serif;
+  font-family: "Questrial", sans-serif;
+  padding: 2rem 0;
 }
 
-h1 {
-    font-family: "Playfair Display", serif;
-    font-size: 58px;
-    color: #232323;
+.display-1 {
+  font-family: "Playfair Display", serif;
+  font-size: 58px;
+  color: #232323;
 }
 
-h1>span {
-    color: #336079;
-}
-
-.book {
-    width: 700px;
-    height: auto;
-    margin-top: -200px;
-    margin-left: 100px;
+.heads {
+  color: #336079;
 }
 
 .btn-download {
-    margin-top: 50px;
-    padding: 15px;
-    background: #232323;
-    color: white;
-    text-align: center;
-    font-size: 25px;
-    border-radius: 3px;
+  --background-color: #232323;
+  padding: 15px;
+  background: var(--background-color);
+  color: white;
+  text-align: center;
+  font-size: 20px;
+  border-radius: 3px;
+  border: 1px solid var(--background-color);
+  cursor: pointer;
 }
 
 .wwa {
-    text-align: center;
-    font-family: "Questrial", sans-serif;
-    font-size: 30px;
+  text-align: center;
+  font-family: "Questrial", sans-serif;
+  font-size: 30px;
 }
 
 .help {
-    width: 100px;
-    height: auto;
+  width: 100px;
+  height: auto;
 }
 
 .second-header {
-    margin: auto;
-    display: flex;
-    justify-content: center;
-    align-items: center;
-    font-family: "Questrial", sans-serif;
-    font-size: 25px;
-    background-color: #f8f8f8;
-    width: 60rem;
-    padding: 25px;
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  align-items: center;
+  font-family: "Questrial", sans-serif;
+  font-size: 25px;
+  background-color: #f8f8f8;
+  padding: 25px;
 }
 
 .help-text {
-    margin-left: 20px;
-    line-height: 50px;
+  margin-left: 20px;
+  line-height: 50px;
+}
+
+.book {
+  width: 400px;
+  max-width: 400px;
 }
 
 .links {
-    display: flex;
-    margin: auto;
-    justify-content: center;
-    align-items: center;
+  display: flex;
+  margin: auto;
+  justify-content: center;
+  align-items: center;
+  flex-wrap: wrap;
 }
 
-.links>a {
-    text-decoration: none;
-    padding: 40px;
-    text-decoration: underline;
-    text-transform: uppercase;
-    font-family: "Questrial", sans-serif;
-    color: #232323;
+.links > a {
+  text-decoration: none;
+  padding: 40px;
+  text-decoration: underline;
+  text-transform: uppercase;
+  font-family: "Questrial", sans-serif;
+  color: #232323;
+}
+.contact-form {
+  display: flex;
+  flex-direction: column;
+  max-width: 90vw;
+  width: 90vw;
+  margin: 0 auto;
 }
 
 .form-group {
-    display: grid;
-    place-items: center;
-    margin-top: 30px;
-    margin-bottom: 30px;
+  /* display: grid;
+  place-items: center;
+  margin-top: 30px;
+  margin-bottom: 30px; */
 }
 
-.input {
-    border: none;
-    outline: none;
-    padding: 20px;
-    padding-right: 80px;
-    background-color: #f8f8f8;
-    width: 500px;
+.email-input {
+  border: none;
+  padding: 20px;
+  background-color: #f8f8f8;
+  margin-bottom: 1rem;
+}
+
+.message-input {
+  border: none;
+  padding: 20px;
+  background-color: #f8f8f8;
+  margin-bottom: 1rem;
+  font-family: inherit;
 }
 
 .submit-btn {
-    background-color: #232323;
-    padding: 20px;
-    margin-left: 20px;
-    padding-left: 40px;
-    padding-right: 40px;
-}
-
-@media (max-width: 1000px) {
-    header {
-        height: 90vh;
-    }
-    .header-main {
-        display: flex;
-        flex-direction: column;
-        padding: 0px;
-        margin: 0;
-        align-items: center;
-        justify-content: center;
-    }
-    h1 {
-        font-size: 20px;
-        margin-bottom: 100px;
-    }
-    .header-txt {
-        margin-bottom: -100px;
-        margin-left: -150px;
-        display: flex;
-        flex-direction: column;
-        margin-bottom: 150px;
-    }
-    .image-header {
-        margin-left: -600px;
-    }
-    .btn-download {
-        padding: 15px;
-        background: #232323;
-        color: white;
-        text-align: center;
-        font-size: 25px;
-        border-radius: 3px;
-    }
-}
