From 946685607bc548462b3082adc79aa0bd3cc926d5 Mon Sep 17 00:00:00 2001
From: Osinachi Chukwujama <Osinachi.Chukwujama@gmail.com>
Date: Fri, 26 Jul 2024 09:04:15 +0100
Subject: [PATCH] Edit file to fit workshop

---
 .../environment-create.sh                     | 41 ++++++++++++-------
 1 file changed, 26 insertions(+), 15 deletions(-)

diff --git a/azure-load-balancer-introduction/environment-create.sh b/azure-load-balancer-introduction/environment-create.sh
index 0bb9bcc..ea178e3 100644
--- a/azure-load-balancer-introduction/environment-create.sh
+++ b/azure-load-balancer-introduction/environment-create.sh
@@ -1,43 +1,57 @@
 group=azure-load-balancer-introduction
-az group create -g $group -l northeurope
-username=adminuser
-password='SecretPassword123!@#'
+location=eastus
+username=azureuser
+password='Test1234!@#$'
+vnetname=vm-vnet
 
+# Create the resource group
+az group create -g $group -l $location
+
+# Create Virtual Network and Subnet
 az network vnet create \
-  -n vm-vnet \
-  -g $group \
-  -l northeurope \
+  --name $vnetname \
+  --resource-group $group \
+  --location $location \
   --address-prefixes '192.168.0.0/16' \
   --subnet-name subnet \
   --subnet-prefixes '192.168.1.0/24'
-  
+
+# Create Availability Set
 az vm availability-set create \
   -n vm-as \
-  -l northeurope \
+  -l $location \
   -g $group
 
+# Create Network Security Group (NSG)
+az network nsg create \
+  -g $group \
+  -n vm-nsg
+
+# Create VMs in a loop
 for NUM in 1 2 3
 do
   az vm create \
     -n vm-eu-0$NUM \
     -g $group \
-    -l northeurope \
+    -l $location \
     --size Standard_B1s \
     --image Win2019Datacenter \
     --admin-username $username \
     --admin-password $password \
-    --vnet-name vm-vnet \
+    --vnet-name $vnetname \
     --subnet subnet \
     --public-ip-address "" \
     --availability-set vm-as \
-	  --nsg vm-nsg
+    --nsg vm-nsg
 done
 
+# Open port 80 for each VM
 for NUM in 1 2 3
 do
   az vm open-port -g $group --name vm-eu-0$NUM --port 80
 done
 
+# Install IIS on each VM using Custom Script Extension
 for NUM in 1 2 3
 do
   az vm extension set \
@@ -46,8 +60,5 @@ do
     -g $group \
     --publisher Microsoft.Compute \
     --version 1.8 \
-    --settings '{"commandToExecute":"powershell Add-WindowsFeature Web-Server; powershell Add-Content -Path \"C:\\inetpub\\wwwroot\\Default.htm\" -Value $($env:computername)"}'
+    --settings '{"commandToExecute":"powershell Add-WindowsFeature Web-Server; powershell Add-Content -Path \\"C:\\inetpub\\wwwroot\\Default.htm\\" -Value \\"$($env:computername)\\""}'
 done
-
-
-
-- 
