Subject: [PATCH] fix: add expose option for port 80

---
 Dockerfile | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/Dockerfile b/Dockerfile
index b009ece..83ae720 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -8,6 +8,8 @@ RUN npm i -g @adonisjs/cli
 # Change working directory
 WORKDIR /var/www
 
+EXPOSE 80
+
 # Copy init.sh
 COPY init.sh /init.sh
 
