From e87b62d01697ea5228d8dcee584a5b63ec318632 Mon Sep 17 00:00:00 2001
From: Osinachi Chukwujama <Osinachi.Chukwujama@gmail.com>
Date: Mon, 2 May 2022 16:21:34 +0100
Subject: [PATCH] ci: add Azure Static Web Apps workflow file on-behalf-of:
 @Azure opensource@microsoft.com

---
 ...re-static-web-apps-icy-plant-018dc7503.yml | 45 +++++++++++++++++++
 1 file changed, 45 insertions(+)
 create mode 100644 .github/workflows/azure-static-web-apps-icy-plant-018dc7503.yml

diff --git a/.github/workflows/azure-static-web-apps-icy-plant-018dc7503.yml b/.github/workflows/azure-static-web-apps-icy-plant-018dc7503.yml
new file mode 100644
index 0000000..4c3f082
--- /dev/null
+++ b/.github/workflows/azure-static-web-apps-icy-plant-018dc7503.yml
@@ -0,0 +1,45 @@
+name: Azure Static Web Apps CI/CD
+
+on:
+  push:
+    branches:
+      - main
+  pull_request:
+    types: [opened, synchronize, reopened, closed]
+    branches:
+      - main
+
+jobs:
+  build_and_deploy_job:
+    if: github.event_name == 'push' || (github.event_name == 'pull_request' && github.event.action != 'closed')
+    runs-on: ubuntu-latest
+    name: Build and Deploy Job
+    steps:
+      - uses: actions/checkout@v2
+        with:
+          submodules: true
+      - name: Build And Deploy
+        id: builddeploy
+        uses: Azure/static-web-apps-deploy@v1
+        with:
+          azure_static_web_apps_api_token: ${{ secrets.AZURE_STATIC_WEB_APPS_API_TOKEN_ICY_PLANT_018DC7503 }}
+          repo_token: ${{ secrets.GITHUB_TOKEN }} # Used for Github integrations (i.e. PR comments)
+          action: "upload"
+          ###### Repository/Build Configurations - These values can be configured to match your app requirements. ######
+          # For more information regarding Static Web App workflow configurations, please visit: https://aka.ms/swaworkflowconfig
+          app_location: "/src" # App source code path
+          api_location: "" # Api source code path - optional
+          output_location: "" # Built app content directory - optional
+          ###### End of Repository/Build Configurations ######
+
+  close_pull_request_job:
+    if: github.event_name == 'pull_request' && github.event.action == 'closed'
+    runs-on: ubuntu-latest
+    name: Close Pull Request Job
+    steps:
+      - name: Close Pull Request
+        id: closepullrequest
+        uses: Azure/static-web-apps-deploy@v1
+        with:
+          azure_static_web_apps_api_token: ${{ secrets.AZURE_STATIC_WEB_APPS_API_TOKEN_ICY_PLANT_018DC7503 }}
+          action: "close"
-- 
