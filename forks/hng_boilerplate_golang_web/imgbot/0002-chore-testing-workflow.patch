Subject: [PATCH] chore: testing workflow

---
 .github/workflows/dev-deploy.yml | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/.github/workflows/dev-deploy.yml b/.github/workflows/dev-deploy.yml
index 18766e6..d268b2a 100644
--- a/.github/workflows/dev-deploy.yml
+++ b/.github/workflows/dev-deploy.yml
@@ -28,7 +28,7 @@ jobs:
           password: ${{ env.SSH_PASSWORD }}
           source: golang_dev.tar.gz
           target: "/tmp"
-       
+
   update_repo_and_create_env:
     runs-on: ubuntu-latest
     needs: build_and_upload_image
@@ -39,7 +39,7 @@ jobs:
       SSH_PASSWORD: ${{ secrets.SSH_PASSWORD }}
     steps:
       - name: Create app.env file
-        uses: ../actions/create-env-action
+        uses: .github/actions/create-env-action/
         with:
           APP_NAME: "development"
           APP_URL: "https://deployment.api-golang.boilerplate.hng.tech"
@@ -77,7 +77,7 @@ jobs:
       SSH_USERNAME: ${{ secrets.SSH_USERNAME }}
       SSH_HOST: ${{ secrets.SSH_HOST }}
       SSH_PASSWORD: ${{ secrets.SSH_PASSWORD }}
-    
+
     steps:
       - name: Update app with latest changes
         uses: appleboy/ssh-action@v1.0.3
