From 01fac9b33423a7a2fc530433f19b1a6354fb1992 Mon Sep 17 00:00:00 2001
From: Osinachi Chukwujama <Osinachi.Chukwujama@gmail.com>
Date: Mon, 8 Jul 2024 09:11:35 +0100
Subject: [PATCH] Replace environment details with .env files

---
 compose.yaml | 15 ++++++---------
 1 file changed, 6 insertions(+), 9 deletions(-)

diff --git a/compose.yaml b/compose.yaml
index 9f997e2..a87a159 100644
--- a/compose.yaml
+++ b/compose.yaml
@@ -1,10 +1,8 @@
 services:
   postgresdb:
     image: postgres:latest
-    environment:
-      POSTGRES_DB: app
-      POSTGRES_USER: app
-      POSTGRES_PASSWORD: humanslovedbs
+    env_file:
+      - ./backend/.env
     ports:
       - "5432:5432"
     volumes:
@@ -22,9 +20,8 @@ services:
       ADMINER_DEFAULT_DRIVER: pgsql
 
   backend:
-    environment:
-      POSTGRES_SERVER: postgresdb
-      POSTGRES_PASSWORD: humanslovedbs
+    env_file:
+      - ./backend/.env
     build:
       context: ./backend
       dockerfile: Dockerfile
@@ -35,8 +32,8 @@ services:
     restart: always
 
   frontend:
-    environment:
-      VITE_API_URL: "https://devopstask2.osinachi.me"
+    env_file:
+      - ./frontend/.env
     build:
       context: ./frontend
       dockerfile: Dockerfile
-- 
2.47.3

